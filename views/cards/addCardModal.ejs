<!-- Add Card Modal -->
<div
    class="modal fade"
    id="addCardModal"
    tabindex="-1"
    aria-labelledby="addCardModalLabel"
    aria-hidden="true"
>
    <div class="modal-dialog modal-lg">
        <div class="modal-content">

            <form action="/cards" method="POST" id="addCardModalForm">

                <div class="modal-header">
                    <h2
                        class="modal-title fs-5"
                        id="addCardModalLabel"
                    >
                        Add a Card
                    </h2>

                    <button
                        type="button"
                        class="btn-close"
                        data-bs-dismiss="modal"
                        aria-label="Close"
                    ></button>
                </div>

                <div class="modal-body">

                    <!-- Card name autocomplete. -->
                    <div class="mb-3 position-relative">
                        <label
                            class="form-label"
                            for="modalCardName"
                        >
                            Card Name
                        </label>

                        <input
                            class="form-control"
                            type="text"
                            id="modalCardName"
                            name="card[name]"
                            autocomplete="off"
                            required
                        >

                        <div
                            id="modalCardSuggestions"
                            class="list-group position-absolute w-100"
                            style="z-index: 1100;"
                        >
                        </div>
                    </div>

                    <!-- Hidden until a card has been selected. -->
                    <div id="modalCardDetails" class="d-none">

                    <!-- Printing, finish, and quantity controls. -->
                    <div class="row mb-3">

                        <!-- Selects the specific printing of the card. -->
                        <div class="col">
                            <label
                                class="form-label"
                                for="modalPrinting"
                            >
                                Printing
                            </label>

                            <select
                                class="form-select"
                                id="modalPrinting"
                                disabled
                            >
                                <option value="">
                                    Select a card first
                                </option>
                            </select>
                        </div>


                        <!-- Selects an available finish for the chosen printing. -->
                        <div class="col">
                            <label
                                class="form-label"
                                for="modalFinish"
                            >
                                Finish
                            </label>

                            <select
                                class="form-select"
                                id="modalFinish"
                                name="card[finish]"
                                disabled
                            >
                                <option value="">
                                    Select a printing first
                                </option>
                            </select>
                        </div>


    <!-- Sets how many copies of this card are being added. -->
    <div class="col-auto">
        <label
            class="form-label"
            for="modalQuantity"
        >
            Quantity
        </label>

        <input
            class="form-control bg-black text-white border-secondary text-center"
            type="number"
            id="modalQuantity"
            name="card[quantity]"
            value="1"
            min="1"
            step="1"
            style="width: 85px;"
        >
    </div>

</div>

                        <!-- Card preview. -->
                        <div class="card mb-3">
                            <div class="row g-0">
                                <div class="col-md-4">
                                    <img
                                        id="modalCardImage"
                                        class="img-fluid rounded-start"
                                        alt="Selected card preview"
                                    >
                                </div>

                                <div class="col-md-8">
                                    <div class="card-body">
                                        <h3
                                            class="card-title"
                                            id="modalCardTitle"
                                        ></h3>

                                        <p
                                            class="card-text"
                                            id="modalCardTypeLine"
                                        ></p>

                                        <p
                                            class="card-text oracle-text"
                                            id="modalCardOracleText"
                                        ></p>

                                        <small
                                            class="text-body-secondary"
                                            id="modalCardSet"
                                        ></small>
                                    </div>
                                </div>
                            </div>
                        </div>

                    </div>

                    <!-- Hidden fields submitted to the existing POST /cards route. -->

                    <input
                        type="hidden"
                        id="modalScryfallId"
                        name="card[scryfallId]"
                    >

                    <input
                        type="hidden"
                        id="modalOracleId"
                        name="card[oracleId]"
                    >

                    <input
                        type="hidden"
                        id="modalSetCode"
                        name="card[setCode]"
                    >

                    <input
                        type="hidden"
                        id="modalSetName"
                        name="card[setName]"
                    >

                    <input
                        type="hidden"
                        id="modalCollectorNumber"
                        name="card[collectorNumber]"
                    >

                    <input
                        type="hidden"
                        id="modalManaCost"
                        name="card[manaCost]"
                    >

                    <input
                        type="hidden"
                        id="modalLeftType"
                        name="leftType"
                    >

                    <input
                        type="hidden"
                        id="modalRightType"
                        name="rightType"
                    >

                    <textarea
                        hidden
                        id="modalOracleTextInput"
                        name="card[oracleText]"
                    ></textarea>

                    <input
                        type="hidden"
                        id="modalRarity"
                        name="card[rarity]"
                    >

                    <input
                        type="hidden"
                        id="modalImageUrl"
                        name="card[imageUrl]"
                    >

                    <!-- JavaScript creates hidden color inputs here. -->
                    <div id="modalColors"></div>
                    <div id="modalColorIdentity"></div>

                </div>

                <div class="modal-footer">
                    <button
                        type="button"
                        class="btn btn-secondary"
                        data-bs-dismiss="modal"
                    >
                        Cancel
                    </button>

                    <button
                        type="submit"
                        class="btn btn-success"
                        id="modalAddCardButton"
                        disabled
                    >
                        Add Card
                    </button>
                </div>

            </form>
        </div>
    </div>
</div>