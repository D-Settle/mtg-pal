<!-- Card Details Modal -->
<div
    class="modal fade"
    id="cardDetailsModal"
    tabindex="-1"
    aria-labelledby="cardDetailsModalLabel"
    aria-hidden="true"
>
    <div class="modal-dialog modal-xl">
        <div class="modal-content">


            <div class="modal-header">
                <h2
                    class="modal-title fs-4"
                    id="cardDetailsModalLabel"
                >
                    Card Details
                </h2>


                <button
                    type="button"
                    class="btn-close"
                    data-bs-dismiss="modal"
                    aria-label="Close"
                ></button>
            </div>


            <div class="modal-body">


                <div class="card mb-3">
                    <div class="row g-0">


                        <!-- Card image, quantity control, and printing information. -->
                        <div class="col-md-4">

                            <div class="image-wrapper">


                                <img
                                    id="detailsCardImage"
                                    class="img-fluid rounded-start"
                                    alt="Selected card"
                                >


                                <form
                                    id="detailsQuantityForm"
                                    method="POST"
                                    class="quantity-overlay position-absolute top-0 end-0 m-2"
                                >
                                    <input
                                        class="quantity-input form-control form-control-sm bg-black text-white border-secondary text-center"
                                        type="number"
                                        id="detailsQuantity"
                                        name="quantity"
                                        min="1"
                                        step="1"
                                    >
                                </form>


                            </div>


                            <!-- Printing information. -->
                            <div class="text-center mt-2 px-2">

                                <small
                                    class="text-body-secondary"
                                    id="detailsCardSet"
                                ></small>

                            </div>

                        </div>


                        <!-- Card information. -->
                        <div class="col-md-8">

                            <div class="card-body d-flex flex-column h-100">


                                <!-- Card name and mana cost. -->
                                <div
                                    class="d-flex align-items-center justify-content-between mb-2"
                                >

                                    <h2
                                        class="card-title mb-0"
                                        id="detailsCardTitle"
                                    ></h2>


                                    <div
                                        class="mana-cost"
                                        id="detailsManaCost"
                                    ></div>

                                </div>


                                <br>


                                <!-- Type line. -->
                                <p
                                    class="card-text"
                                    id="detailsCardTypeLine"
                                ></p>


                                <br>


                                <!-- Oracle text. -->
                                <p
                                    class="card-text oracle-text"
                                    id="detailsCardOracleText"
                                ></p>


                                <!-- Format legalities. -->
                                <div class="mt-4">

                                    <h6 class="mb-2">
                                        Format Legalities
                                    </h6>


                                    <div class="table-responsive">

                                        <table
                                            class="table table-sm table-bordered align-middle mb-0 legality-table"
                                        >
                                            <tbody id="detailsCardLegalities">
                                            </tbody>
                                        </table>

                                    </div>

                                </div>


                                <!-- Last updated information. -->
                                <div class="mt-auto text-end pt-3">

                                    <small
                                        class="text-body-secondary"
                                        id="detailsUpdatedAt"
                                    ></small>

                                </div>


                            </div>
                        </div>


                    </div>
                </div>


                <!-- Card actions. -->
                <div class="d-flex justify-content-end align-items-center">


                    <div class="d-flex gap-2">


                        <button
                            type="button"
                            class="btn btn-info"
                            id="detailsEditButton"
                        >
                            Edit
                        </button>


                        <form
                            id="detailsDeleteForm"
                            method="POST"
                            class="m-0"
                        >
                            <button
                                type="submit"
                                class="btn btn-danger"
                            >
                                Delete
                            </button>
                        </form>


                    </div>


                </div>


            </div>


        </div>
    </div>
</div>