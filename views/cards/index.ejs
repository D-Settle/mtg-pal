<%- layout('layouts/boilerplate') %>

<div class="d-flex align-items-center gap-3 mb-3">
    <h1 class="mb-0">Your Collection</h1>

    <a href="/cards/new" class="btn btn-primary">
        Add Card
    </a>
</div>

<hr class="border-secondary-subtle mb-4">

<!-- Displays every card in the collection in a four-column responsive grid. -->
<div class="row">
    <% for (let card of cards) { %>
        <div class="col-md-3 mb-4">

            <div class="card-wrapper">

                <!-- Each card image links to its individual show page. -->
                <a href="/cards/<%= card._id %>">
                    <img
                        src="<%= card.imageUrl %>"
                        alt="<%= card.name %>"
                        class="img-fluid rounded shadow"
                    >
                </a>

                <!-- Updates only the card's quantity through the quantity PATCH route. -->
                <form
                    action="/cards/<%= card._id %>/quantity?_method=PATCH"
                    method="POST"
                    class="quantity-overlay position-absolute top-0 end-0 m-2"
                    style="z-index: 10;"
                >
                    <input
                        type="hidden"
                        name="redirectTo"
                        value="/cards"
                    >

                    <input
                        class="form-control form-control-sm bg-black text-white border-secondary text-center"
                        type="number"
                        name="quantity"
                        value="<%= card.quantity %>"
                        min="1"
                        step="1"
                        style="width: 60px;"
                    >
                </form>

            </div>

        </div>
    <% } %>
</div>

<script>
    // Updates card quantities asynchronously so the collection page does not reload.
    document.querySelectorAll('input[name="quantity"]').forEach(input => {
        input.addEventListener('change', async () => {

            const form = input.form;

            try {
                const response = await fetch(form.action, {
                    method: 'POST',
                    body: new FormData(form)
                });

                if (!response.ok) {
                    throw new Error('Unable to update quantity.');
                }

                const result = await response.json();

                console.log(result);

            } catch (error) {
                console.error(error);
            }

        });
    });
</script>